<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#10182B">

    <!-- Welcome Image -->
    <ImageView
        android:id="@+id/imgWelcome"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/code"
        android:contentDescription="Proud coder illustration"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp" />

    <!-- SkillPath Title -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Skill in White -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skill"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="40sp"
            android:includeFontPadding="false" />

        <!-- Path in Purple -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Path"
            android:textColor="#A78BFA"
            android:textStyle="bold"
            android:textSize="40sp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discover Your Tech Career"
        android:textColor="#C4B5FD"
        android:textSize="19sp"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explore your interests and find the technology career path that suits you best."
        android:textColor="#CBD5E1"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="35dp" />

    <!-- Start Assessment Button -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_height="56dp"
        android:text="Start Assessment"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7C3AED" />

</LinearLayout>

